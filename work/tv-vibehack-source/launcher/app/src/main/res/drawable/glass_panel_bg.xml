<?xml version="1.0" encoding="utf-8"?>
<!-- einui liquid glass, ported natively: bg-white/10 + border-white/20 + rounded-4xl (32px) + a
     white/20 top sheen fading to transparent. No backdrop blur: this app runs on a 1 GB box where a
     blur layer costs frames. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="32dp" />
            <solid android:color="#1AFFFFFF" />
            <stroke
                android:width="1dp"
                android:color="#33FFFFFF" />
        </shape>
    </item>

    <!-- top sheen -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="32dp" />
            <gradient
                android:angle="270"
                android:startColor="#33FFFFFF"
                android:centerColor="#0DFFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>

    <!-- inset hairline: einui's after:shadow-[inset_0_1px_1px_rgba(255,255,255,0.1)] -->
    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="31dp" />
            <solid android:color="#00000000" />
            <stroke
                android:width="1dp"
                android:color="#1AFFFFFF" />
        </shape>
    </item>
</layer-list>

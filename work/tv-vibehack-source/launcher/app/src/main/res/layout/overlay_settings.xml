<?xml version="1.0" encoding="utf-8"?>
<!-- Control Centre popover. The panel blurs a copy of the current wallpaper behind itself at open time
     (software box blur, once), so the glass has something real to refract on API 26. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settingsOverlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#00000000"
    android:clickable="true"
    android:focusable="true"
    android:visibility="gone">

    <FrameLayout
        android:id="@+id/ccPanel"
        android:layout_width="292dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="74dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/glass_panel_bg"
        android:clipToOutline="true">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingTop="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 600"
                android:includeFontPadding="false"
                android:text="Control Centre"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/btnSettingsClose"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:background="@drawable/glass_tile_bg"
                android:clickable="true"
                android:contentDescription="Close"
                android:focusable="true"
                android:padding="5dp"
                android:src="@drawable/ios_x_mark" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/btnSysWifi"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginStart="0dp"
                android:background="@drawable/glass_tile_bg"
                android:clickable="true"
                android:drawableStart="@drawable/ic_wifi_clean"
                android:drawablePadding="5dp"
                android:focusable="true"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 500"
                android:gravity="center_vertical"
                android:paddingStart="7dp"
                android:paddingEnd="6dp"
                android:text="Network"
                android:textColor="@drawable/setting_option_text"
                android:textSize="9sp" />
            <TextView
                android:id="@+id/btnSysSettings"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/glass_tile_bg"
                android:clickable="true"
                android:drawableStart="@drawable/ic_settings"
                android:drawablePadding="5dp"
                android:focusable="true"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 500"
                android:gravity="center_vertical"
                android:paddingStart="7dp"
                android:paddingEnd="6dp"
                android:text="Settings"
                android:textColor="@drawable/setting_option_text"
                android:textSize="9sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/btnSysApps"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginStart="0dp"
                android:background="@drawable/glass_tile_bg"
                android:clickable="true"
                android:drawableStart="@drawable/ios_folder"
                android:drawablePadding="5dp"
                android:focusable="true"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 500"
                android:gravity="center_vertical"
                android:paddingStart="7dp"
                android:paddingEnd="6dp"
                android:text="Apps"
                android:textColor="@drawable/setting_option_text"
                android:textSize="9sp" />
            <TextView
                android:id="@+id/btnScreensaver"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/glass_tile_bg"
                android:clickable="true"
                android:drawableStart="@drawable/ic_screensaver"
                android:drawablePadding="5dp"
                android:focusable="true"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 500"
                android:gravity="center_vertical"
                android:paddingStart="7dp"
                android:paddingEnd="6dp"
                android:text="Screensaver"
                android:textColor="@drawable/setting_option_text"
                android:textSize="9sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/btnNextWall"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginStart="0dp"
                android:background="@drawable/glass_tile_bg"
                android:clickable="true"
                android:drawableStart="@drawable/ic_refresh"
                android:drawablePadding="5dp"
                android:focusable="true"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 500"
                android:gravity="center_vertical"
                android:paddingStart="7dp"
                android:paddingEnd="6dp"
                android:text="Next wallpaper"
                android:textColor="@drawable/setting_option_text"
                android:textSize="9sp" />
            <TextView
                android:id="@+id/btnSleep"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/glass_tile_bg"
                android:clickable="true"
                android:drawableStart="@drawable/ic_clock"
                android:drawablePadding="5dp"
                android:focusable="true"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 500"
                android:gravity="center_vertical"
                android:paddingStart="7dp"
                android:paddingEnd="6dp"
                android:text="Sleep off"
                android:textColor="@drawable/setting_option_text"
                android:textSize="9sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:background="@drawable/glass_tile_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="7dp"
                android:paddingEnd="6dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ios_light_bulb" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/outfit"
                    android:maxLines="1"
                    android:text="OLED care"
                    android:textColor="#CCFFFFFF"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/btnDriftOn"
                    android:layout_width="34dp"
                    android:layout_height="22dp"
                    android:background="@drawable/glass_tile_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/outfit"
                    android:gravity="center"
                    android:text="On"
                    android:textColor="@drawable/setting_option_text"
                    android:textSize="8sp" />

                <TextView
                    android:id="@+id/btnDriftOff"
                    android:layout_width="34dp"
                    android:layout_height="22dp"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/glass_tile_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/outfit"
                    android:gravity="center"
                    android:text="Off"
                    android:textColor="@drawable/setting_option_text"
                    android:textSize="8sp" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/btnPeekUltra"
                android:layout_width="0dp"
                android:layout_height="24dp"
                android:layout_weight="1"
                android:layout_marginStart="0dp"
                android:background="@drawable/glass_tile_bg"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 500"
                android:gravity="center"
                android:text="Hidden"
                android:textColor="@drawable/setting_option_text"
                android:textSize="10sp" />
            <TextView
                android:id="@+id/btnPeekBalanced"
                android:layout_width="0dp"
                android:layout_height="24dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:background="@drawable/glass_tile_bg"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 500"
                android:gravity="center"
                android:text="Half"
                android:textColor="@drawable/setting_option_text"
                android:textSize="10sp" />
            <TextView
                android:id="@+id/btnPeekNone"
                android:layout_width="0dp"
                android:layout_height="24dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:background="@drawable/glass_tile_bg"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 500"
                android:gravity="center"
                android:text="Always"
                android:textColor="@drawable/setting_option_text"
                android:textSize="10sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/btnWallFast"
                android:layout_width="0dp"
                android:layout_height="24dp"
                android:layout_weight="1"
                android:layout_marginStart="0dp"
                android:background="@drawable/glass_tile_bg"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 500"
                android:gravity="center"
                android:text="1:30"
                android:textColor="@drawable/setting_option_text"
                android:textSize="10sp" />
            <TextView
                android:id="@+id/btnWallSlow"
                android:layout_width="0dp"
                android:layout_height="24dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:background="@drawable/glass_tile_bg"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 500"
                android:gravity="center"
                android:text="5 min"
                android:textColor="@drawable/setting_option_text"
                android:textSize="10sp" />
            <TextView
                android:id="@+id/btnWallOff"
                android:layout_width="0dp"
                android:layout_height="24dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:background="@drawable/glass_tile_bg"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 500"
                android:gravity="center"
                android:text="Paused"
                android:textColor="@drawable/setting_option_text"
                android:textSize="10sp" />
            <ImageView
                android:id="@+id/btnWallRefresh"
                android:layout_width="0dp"
                android:layout_height="24dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="@drawable/glass_tile_bg"
                android:clickable="true"
                android:contentDescription="Find new wallpapers"
                android:focusable="true"
                android:padding="4dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_refresh" />
        </LinearLayout>


        </LinearLayout>
    </FrameLayout>
</FrameLayout>
